;; Gridline inspector v1. Loading defines a command only; it never runs it.
;; No drawing writes, commands, file writes, ActiveX, eval, or startup hooks.
(defun gl-q (s / i c out)
  (setq i 1 out "\"")
  (while (<= i (strlen s))
    (setq c (substr s i 1))
    (setq out (strcat out (cond ((= c "\"") "\\\"") ((= c "\\") "\\\\")
      ((= c (chr 10)) "\\n") ((= c (chr 13)) "\\r") ((= c (chr 9)) "\\t")
      ((< (ascii c) 32) "?") (T c))))
    (setq i (1+ i)))
  (strcat out "\""))
(defun gl-array (items / out sep item)
  (setq out "[" sep "")
  (foreach item items (setq out (strcat out sep item) sep ","))
  (strcat out "]"))
(defun gl-point (p) (gl-array (mapcar '(lambda (v) (gl-q (rtos v 2 8))) p)))
(defun c:GRIDLINEINSPECT (/ actual ss n i d typ counts pair layers row layouts views result before)
  (setq actual (strcat (getvar "DWGPREFIX") (getvar "DWGNAME")))
  (if (/= actual @DRAWING@)
    (princ "\nGRIDLINE_BLOCKED: wrong drawing; open the selected disposable copy.")
    (progn
      (setq before (getvar "DBMOD") ss (ssget "_X" '((410 . "Model"))) n 0)
      (if ss (setq n (sslength ss)))
      (if (> n 100000) (princ "\nGRIDLINE_BLOCKED: entity cap exceeded.")
        (progn
          (setq i 0 counts nil layers nil views nil)
          (while (< i n)
            (setq d (entget (ssname ss i)) typ (cdr (assoc 0 d)) pair (assoc typ counts))
            (if pair (setq counts (subst (cons typ (1+ (cdr pair))) pair counts))
              (setq counts (cons (cons typ 1) counts)))
            (setq i (1+ i)))
          (setq row (tblnext "LAYER" T) i 0)
          (while (and row (< i 2048))
            (setq layers (cons (strcat "{\"name\":" (gl-q (cdr (assoc 2 row)))
              ",\"flags\":" (itoa (cdr (assoc 70 row)))
              ",\"color\":" (itoa (cdr (assoc 62 row))) "}") layers))
            (setq row (tblnext "LAYER") i (1+ i)))
          (setq layouts (layoutlist) ss (ssget "_X" '((0 . "VIEWPORT"))) i 0)
          (if ss (while (and (< i (sslength ss)) (< i 256))
            (setq d (entget (ssname ss i)))
            (if (> (cdr (assoc 69 d)) 1)
              (setq views (cons (strcat "{\"layout\":" (gl-q (cdr (assoc 410 d)))
                ",\"paper_height\":" (gl-q (rtos (cdr (assoc 41 d)) 2 8))
                ",\"view_height\":" (gl-q (rtos (cdr (assoc 45 d)) 2 8))
                ",\"flags\":" (itoa (cdr (assoc 90 d))) "}") views)))
            (setq i (1+ i))))
          (if (or row (> (length layouts) 64) (and ss (> (sslength ss) 256)))
            (princ "\nGRIDLINE_BLOCKED: table cap exceeded.")
            (progn
              (setq result (strcat "{\"schema\":\"gridline-autocad-read.v1\",\"probe_id\":" (gl-q @PROBE@)
                ",\"document\":" (gl-q actual) ",\"acadver\":" (gl-q (getvar "ACADVER"))
                ",\"platform\":" (gl-q (getvar "PLATFORM"))
                ",\"insunits\":" (itoa (getvar "INSUNITS"))
                ",\"dbmod_before\":" (itoa before) ",\"dbmod_after\":" (itoa (getvar "DBMOD"))
                ",\"model_entity_count\":" (itoa n)
                ",\"entity_types\":" (gl-array (mapcar '(lambda (p) (strcat "[" (gl-q (car p)) "," (itoa (cdr p)) "]")) counts))
                ",\"layers\":" (gl-array (reverse layers))
                ",\"layouts\":" (gl-array (mapcar 'gl-q layouts))
                ",\"viewports\":" (gl-array views)
                ",\"extmin\":" (gl-point (getvar "EXTMIN"))
                ",\"extmax\":" (gl-point (getvar "EXTMAX")) "}"))
              (princ (strcat "\nGRIDLINE_READ_BEGIN\n" result "\nGRIDLINE_READ_END"))))))))
  (princ))
(princ "\nGridline inspector loaded; run GRIDLINEINSPECT on the selected copy.")
(princ)
